# Notion integration token (server-side only, never exposed to browser)
NOTION_API_KEY=

# Shared secret gating the dashboard API. Pick any string.
# Must match the ?token= param used in the Notion embed URL.
WIDGET_TOKEN=

# Optional overrides — defaults already point at the correct Shin Supplies DBs
